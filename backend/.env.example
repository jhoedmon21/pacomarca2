# Google Earth Engine
GEE_PROJECT=egresados-q9tr
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY_JSON=

# Open-Meteo (sin API key, sin configuración)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Cache
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
RATE_LIMIT_PER_MINUTE=100

# Default values
DEFAULT_LAT=-14.85
DEFAULT_LON=-70.92
ROI_BUFFER_M=2000

# Base de datos (SQLite local por defecto; ver .env.example raiz para Postgres gratuito)
DATABASE_URL=sqlite+aiosqlite:///./data/pacomarca.db
# DATABASE_URL=postgresql+asyncpg://usuario:clave@ep-xxxx.neon.tech/pacomarca?ssl=require
DATABASE_ECHO=false
