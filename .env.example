# ============================================================
# Pacomarca Scientific Suite - configuración de producción (docker compose)
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA hagas commit de .env (está en .gitignore).
# ============================================================

# --- Dominio y HTTPS (Caddy emite el certificado automáticamente) ---
# En local deja SITE_ADDRESS=:80
SITE_ADDRESS=:80
# SITE_ADDRESS=pacomarca.tudominio.com

# --- Google Earth Engine (cuenta de servicio) ---
GEE_PROJECT=egresados-q9tr
GEE_SERVICE_ACCOUNT_EMAIL=pacomarca@egresados-q9tr.iam.gserviceaccount.com
# Contenido COMPLETO del JSON de la clave privada, o ruta a un secret montado
GEE_PRIVATE_KEY_JSON=

# --- Open-Meteo: sin API key (gratuito, sin registro) ---

# --- Aplicación ---
APP_ENV=production
APP_DEBUG=false
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=100

# --- Base de datos (puntos guardados + historial de alertas) ---
# Opción A (por defecto): SQLite en volumen Docker. Cero configuración, gratis.
#DATABASE_URL=sqlite+aiosqlite:////srv/app/data/pacomarca.db
# Opción B: Postgres gestionado GRATIS en la nube (elige uno):
#   - Neon:      https://neon.tech   -> 0.5 GB, serverless, sin tarjeta
#   - Supabase:  https://supabase.com -> 500 MB, incluye panel y auth
#   - Railway:   https://railway.app -> plan de prueba con crédito mensual
#   - Aiven:     https://aiven.io    -> plan free de Postgres
# Crea la base, copia la cadena de conexión y añade ?ssl=require al final:
#DATABASE_URL=postgresql+asyncpg://usuario:clave@ep-xxxx.neon.tech/pacomarca?ssl=require
# Si el proveedor entrega la URL como postgresql://... (Railway, Render),
# cópiala TAL CUAL: la app añade el driver asyncpg automáticamente.

# --- CORS: origen público del frontend ---
ALLOWED_ORIGINS=https://pacomarca.tudominio.com

# --- Punto de control por defecto (Pacomarca, Puno) ---
DEFAULT_LAT=-14.85
DEFAULT_LON=-70.92
ROI_BUFFER_M=2000

# --- Modelo de biomasa (heurístico) ---
BIOMASS_COEFFICIENT=2800

# --- Alerta diaria por email (opcional; ver deploy/jobs/alerta_diaria.py) ---
# Programar con cron: docker compose --profile jobs run --rm alerta
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTA_EMAIL_DESTINO=
ALERTA_UMBRAL_PORCENTAJE=-15
ANIOS_ALERTA=20
